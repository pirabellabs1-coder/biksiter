# Copier en « .env.local », qui n'est jamais versionné.

# La base de développement lancée par docker-compose.yml.
DATABASE_URL=postgres://bikesitters:developpement@localhost:5432/bikesitters

# Mettre « requis » en production : l'hébergeur impose TLS et le certificat
# doit être vérifié. « chiffre » chiffre la connexion sans vérifier le
# certificat (pooler Supabase sans autorité fournie) : à remplacer dès que le
# certificat racine est disponible. En local il n'y a pas de TLS : vide.
DATABASE_SSL=

# Taille de la réserve de connexions et délai de connexion (ms). Les valeurs
# par défaut (10 et 5000) suffisent en production ; en local contre une base
# distante, 30 et 15000 évitent les délais dépassés.
# DATABASE_POOL_MAX=10
# DATABASE_DELAI_CONNEXION_MS=5000

# Il n'y a pas de clé de signature de session : le cookie ne porte qu'un jeton
# opaque de 256 bits, dont la base ne garde que l'empreinte SHA-256. Rien à
# signer, donc rien à faire fuir.

# L'adresse publique du site, pour les liens envoyés par courriel (confirmation
# d'adresse, nouveau mot de passe). Obligatoire en production ; en
# développement, http://localhost:3000 est pris par défaut.
ADRESSE_DU_SITE=

# Envoi des courriels (Brevo : smtp://LOGIN:CLE@smtp-relay.brevo.com:587, avec
# l'arobase du login écrite %40). Sans SMTP_URL, rien ne part et l'étape de
# confirmation de l'adresse est sautée ; « npm run bd:messages » montre la file.
# L'expéditeur doit être validé chez Brevo.
SMTP_URL=
COURRIEL_EXPEDITEUR=Bike Sitters <bonjour@bikesitters.be>

# Secret de la tâche quotidienne /api/envois (Vercel l'envoie seul). Sans lui,
# la route ne répond pas.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Géocodage. Vide = Nominatim (OpenStreetMap). Une instance auto-hébergée
# évite d'envoyer l'adresse des membres à un tiers.
GEOCODEUR_URL=
GEOCODEUR_CONTACT=BikeSitters (association, Bruxelles) — bonjour@bikesitters.be

# Chiffrement des pièces d'identité (AES-256-GCM), 32 octets en hexadécimal.
# Sans elle, le dépôt reste fermé : on ne stocke pas une pièce en clair.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLE_DES_PIECES=

# Passerelle SMS, pour la vérification des numéros. Sans elle, le numéro
# s'enregistre sans code et « npm run bd:messages » montre les SMS en attente.
SMS_URL=
SMS_JETON=

# Le mot de passe du compte de démonstration, lu par scripts/compte-demo.ts.
# Jamais écrit dans le code : ce compte existe en production.
MOT_DE_PASSE_DEMO=
