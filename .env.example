# Copier en « .env.local », qui n'est jamais versionné.

# La base de développement lancée par docker-compose.yml.
DATABASE_URL=postgres://bikesitters:developpement@localhost:5432/bikesitters

# Mettre « requis » en production : l'hébergeur impose TLS et le certificat
# doit être vérifié. En local il n'y a pas de TLS, donc on laisse vide.
DATABASE_SSL=

# Il n'y a pas de clé de signature de session : le cookie ne porte qu'un jeton
# opaque de 256 bits, dont la base ne garde que l'empreinte SHA-256. Rien à
# signer, donc rien à faire fuir.

# Envoi des courriels. Sans SMTP_URL, « npm run bd:courriels » affiche les
# messages en attente au lieu de les expédier — pratique en développement.
SMTP_URL=
COURRIEL_EXPEDITEUR=Bike Sitters <bonjour@bikesitters.be>

# Géocodage. Vide = Nominatim (OpenStreetMap). Une instance auto-hébergée
# évite d'envoyer l'adresse des membres à un tiers.
GEOCODEUR_URL=
GEOCODEUR_CONTACT=BikeSitters (association, Bruxelles) — bonjour@bikesitters.be

# Chiffrement des pièces d'identité (AES-256-GCM), 32 octets en hexadécimal.
# Sans elle, le dépôt reste fermé : on ne stocke pas une pièce en clair.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLE_DES_PIECES=
